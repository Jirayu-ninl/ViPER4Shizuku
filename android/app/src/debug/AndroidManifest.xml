<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only test hooks. Not present in release builds. Lets the device-test scripts drive
     ViperService over adb without exporting it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.EngineTestReceiver"
            android:exported="true" />
    </application>
</manifest>
